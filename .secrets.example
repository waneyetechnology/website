# =============================================================================
# Waneye Local Deploy — Secrets for act (GitHub Actions runner)
# =============================================================================
# Copy this file to .secrets and fill in your API keys:
#   cp .secrets.example .secrets
#
# This file is used by deploy-local.sh in act mode.
# Format: KEY=VALUE (no quotes, no spaces around =)
# Never commit .secrets to git!
# =============================================================================

OPENAI_API_KEY=sk-your-openai-key-here
NEWSAPI_API_KEY=your-newsapi-key-here
FMP_API_KEY=your-fmp-key-here
MARKETAUX_API_KEY=your-marketaux-key-here
GNEWS_API_KEY=your-gnews-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
GEMINI_API_KEY=your-gemini-key-here
GH_PAT=ghp_your-github-pat-here

# ── Ollama (optional — auto-detected by deploy-local.sh) ─────────────────────
# When running via act, the script auto-detects Ollama on the host and sets
# OLLAMA_HOST to http://host.docker.internal:11434/v1 so the container can
# reach it. You only need to set these if you want to override the defaults.
# OLLAMA_HOST=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=qwen3.8:27b-mlx
